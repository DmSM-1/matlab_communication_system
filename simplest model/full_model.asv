clear; clc;

dataset_path = "Datasets";


sim = OFDM_System( ...
    OutputDir   = dataset_path, ...
    SNR         = 30, ...  
    ChanModel   = "Model-A", ...
    N           = 64, ...
    L           = 32, ...
    Mod_pow     = 4, ...        
    Bw          = 0.5, ... 
    Ndat        = 48, ...
    Npil        = 4, ...
    data_Nsymb  = 2, ...
    Fc          = 2.4e9, ...
    Fs          = 5e6, ...
    alpha       = 0.5, ...
    beta        = 0.2 ...
);

% sim.generate_dataset(1);
% sim.run_channel_on_dataset();
% sim.run_sdr_channel_on_dataset(); 
sim.process_dataset();

fprintf("\n");